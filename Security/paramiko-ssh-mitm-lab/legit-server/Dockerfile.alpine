# Alternativa Alpine para legit-server. Usar SOLO si el build con la base
# Debian falla repetidamente por el CDN de deb.debian.org.
#
# Para activarla:
#   1) renombrar:  legit-server/Dockerfile          -> Dockerfile.debian
#                  legit-server/Dockerfile.alpine   -> Dockerfile
#   2) o bien apuntar el compose a este Dockerfile con build.dockerfile.

FROM alpine:3.20

# openssh = sshd, openssh-sftp-server = subsistema SFTP, shadow = chpasswd,
# bash para que appuser tenga shell familiar.
RUN apk add --no-cache openssh openssh-sftp-server bash shadow

# Usuario equivalente al de la version Debian
RUN adduser -D -s /bin/bash appuser \
 && echo 'appuser:s3cret-pharma-data' | chpasswd

# Fichero secreto que el cliente leera por SFTP
RUN mkdir -p /data \
 && echo 'datos confidenciales del pharma pipeline' > /data/secret.txt \
 && chown -R appuser:appuser /data \
 && chmod 600 /data/secret.txt

# Generar TODAS las host keys (rsa, ed25519, etc)
RUN ssh-keygen -A

# Permitir auth por password (reproduce el patron real)
RUN sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
 && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
